# ===========================
# 데이터베이스 설정
# ===========================
# PostgreSQL 연결 문자열 — 실제 값으로 교체 필요
DATABASE_URL="postgresql://user:password@localhost:5432/auth_db?schema=public"

# ===========================
# Auth.js v5 (NextAuth) 설정
# ===========================
# openssl rand -base64 32 명령어로 생성한 무작위 비밀값
AUTH_SECRET="your-auth-secret-here"

# 애플리케이션 기본 URL (로컬 개발 시 http://localhost:3000)
AUTH_URL="http://localhost:3000"

# ===========================
# [DEFERRED] OAuth 제공자 (REQ-AUTH-003)
# ===========================
# Google OAuth 클라이언트 ID — Google Cloud Console에서 발급
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================
# [DEFERRED] 이메일 전송 (REQ-AUTH-004)
# ===========================
# Resend API 키 — https://resend.com 에서 발급
# RESEND_API_KEY="re_xxxxxxxxxxxx"
